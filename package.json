{
  "name": "telashare",
  "productName": "TelaShare",
  "version": "1.9.5",
  "description": "TelaShare - compartilhamento de tela com áudio",
  "main": "main.js",
  "author": "Juliano Machado da Silva (https://github.com/JulianoMachadoS)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/JulianoMachadoS/telashare.git"
  },
  "homepage": "https://github.com/JulianoMachadoS/telashare#readme",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "test": "electron test/local-e2e.js"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.telashare.app",
    "productName": "TelaShare",
    "files": [
      "main.js",
      "window-state.js",
      "pcm-worklet.js",
      "pc-audio.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "style.css",
      "build/icon.png",
      "LICENSE",
      "NOTICE",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "legalTrademarks": "TelaShare - AGPL-3.0-or-later"
    },
    "portable": {
      "artifactName": "TelaShare.exe"
    },
    "copyright": "Copyright (C) 2026 Juliano Machado da Silva",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "protocols": [
      {
        "name": "TelaShare",
        "schemes": [
          "telashare"
        ]
      }
    ],
    "nsis": {
      "artifactName": "TelaShare-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TelaShare",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JulianoMachadoS",
        "repo": "telashare",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "native/bin/telashare-audio.exe",
        "to": "telashare-audio.exe"
      }
    ]
  }
}
