{
  "name": "telashare",
  "productName": "TelaShare",
  "version": "1.3.6",
  "description": "TelaShare - compartilhamento de tela com áudio",
  "main": "main.js",
  "author": "Juliano Machado da Silva (https://github.com/JulianoMachadoS)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/JulianoMachadoS/telashare.git"
  },
  "homepage": "https://github.com/JulianoMachadoS/telashare#readme",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64",
    "test": "electron test/local-e2e.js"
  },
  "dependencies": {
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.telashare.app",
    "productName": "TelaShare",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "build/icon.png",
      "node_modules/peerjs/dist/peerjs.min.js",
      "LICENSE",
      "NOTICE",
      "node_modules/peerjs/LICENSE"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false,
      "legalTrademarks": "TelaShare - AGPL-3.0-or-later"
    },
    "portable": {
      "artifactName": "TelaShare.exe"
    },
    "copyright": "Copyright (C) 2026 Juliano Machado da Silva",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "protocols": [
      {
        "name": "TelaShare",
        "schemes": [
          "telashare"
        ]
      }
    ]
  }
}
